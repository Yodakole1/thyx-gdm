#!/usr/bin/env bash
#
# Removes Thyx and hands the greeter back to the distro's own theme.
#
# Safe to run from a TTY if the login screen is ever unhappy:
#   Ctrl+Alt+F3, log in, cd into this repo, ./scripts/uninstall --yes

set -Eeuo pipefail

THYX_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=scripts/lib/_constants.sh
. "${THYX_SCRIPT_DIR}/lib/_constants.sh"
# shellcheck source=scripts/lib/_common.sh
. "${THYX_SCRIPT_DIR}/lib/_common.sh"
# shellcheck source=scripts/lib/_repo.sh
. "${THYX_SCRIPT_DIR}/lib/_repo.sh"
# shellcheck source=scripts/lib/_gdm.sh
. "${THYX_SCRIPT_DIR}/lib/_gdm.sh"

trap '_thyx_on_err' ERR

THYX_KEEP_FONTS=0

_thyx_uninstall_usage() {
  cat <<'EOF'
usage: scripts/uninstall [--keep-fonts] [--yes]

  --keep-fonts    leave the bundled fonts installed system wide
  --yes, -y       do not ask for confirmation
EOF
}

_thyx_uninstall_parse_args() {
  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --keep-fonts) THYX_KEEP_FONTS=1 ;;
      --yes|-y) THYX_AUTO_YES=1 ;;
      --help|-h) _thyx_uninstall_usage; exit 0 ;;
      *) _thyx_die "unknown arg: $1" ;;
    esac
    shift
  done
}

_thyx_uninstall_plan() {
  local method="${1:?}"

  _thyx_hr
  _thyx_log "  deactivate ${method}"
  if [ "${method}" = "alternatives" ]; then
    _thyx_log "             update-alternatives --remove ${THYX_ALTERNATIVE} ${THYX_GRESOURCE_DST}"
  else
    _thyx_log "             restore $(_thyx_target_file) from ${THYX_GDM_BACKUP}"
  fi
  _thyx_log "  remove     ${THYX_THEME_ROOT}"
  if [ -d "${THYX_EXTENSION_DST}" ]; then
    _thyx_log "  remove     ${THYX_EXTENSION_DST}"
  fi
  _thyx_log "  remove     ${THYX_DCONF_FILE}"
  case "$(_thyx_recorded_profile_outcome)" in
    created) _thyx_log "  remove     ${THYX_DCONF_PROFILE_FILE}" ;;
    edited)  _thyx_log "  restore    ${THYX_DCONF_PROFILE_FILE}" ;;
    *)       _thyx_log "  keep       ${THYX_DCONF_PROFILE_FILE} (not written by thyx)" ;;
  esac
  _thyx_log "  remove     ${THYX_STATE_DIR}"
  if [ "${THYX_KEEP_FONTS}" -eq 1 ]; then
    _thyx_log "  keep       ${THYX_FONTS_DST}"
  else
    _thyx_log "  remove     ${THYX_FONTS_DST}"
  fi
  _thyx_hr
  _thyx_log ""
  _thyx_log "  SDDM is not involved and nothing restarts: the distro greeter"
  _thyx_log "  comes back the next time you log out or reboot."
  _thyx_log ""
}

# What the install recorded about /etc/dconf/profile/gdm: none, created or
# edited. Falls back to inspecting the file, for an install that predates the
# state file carrying this.
_thyx_recorded_profile_outcome() {
  local recorded=""

  if [ -f "${THYX_STATE_FILE}" ]; then
    recorded="$(awk -F= '/^dconf_profile=/ { print $2 }' "${THYX_STATE_FILE}")"
  fi

  if [ -n "${recorded}" ]; then
    printf '%s\n' "${recorded}"
  elif _thyx_dconf_profile_is_ours; then
    printf 'created\n'
  else
    printf 'none\n'
  fi
}

_thyx_uninstall_verify() {
  local active

  [ ! -e "${THYX_GRESOURCE_DST}" ] ||
    _thyx_die "theme still present: ${THYX_GRESOURCE_DST}"

  active="$(_thyx_active_gresource || true)"

  if [ -z "${active}" ]; then
    _thyx_warn "no greeter theme resolves; gnome-shell will fall back to its built-in stylesheet"
    return 0
  fi

  case "${active}" in
    "${THYX_THEME_ROOT}"/*)
      _thyx_die "greeter still points into the thyx directory: ${active}"
      ;;
  esac

  [ -f "${active}" ] || _thyx_die "greeter points at a missing file: ${active}"

  _thyx_ok "greeter theme resolves to ${active}"
}

main() {
  _thyx_uninstall_parse_args "$@"

  # Uninstalling needs nothing out of the repo, but refusing to run from
  # outside it keeps this from being mistaken for a system-wide tool.
  _thyx_find_repo "${THYX_SCRIPT_DIR}" >/dev/null
  THYX_LOG_PREFIX="thyx-uninstall"
  _thyx_setup_log

  local method
  method="$(_thyx_activation_method)"

  _thyx_step "plan"
  _thyx_uninstall_plan "${method}"
  _thyx_confirm "remove thyx and restore the distro greeter? [y/N]"

  _thyx_sudo_warmup

  # Deactivate before deleting, so the link never points at a file that is
  # already gone.
  _thyx_step "deactivate"
  _thyx_deactivate
  _thyx_ok "greeter theme released"

  _thyx_step "remove"

  # Before the state directory goes, since that is where the backup lives.
  _thyx_dconf_profile_restore "$(_thyx_recorded_profile_outcome)"

  _thyx_remove_one "${THYX_THEME_ROOT}"
  _thyx_remove_one "${THYX_EXTENSION_DST}"
  _thyx_remove_one "${THYX_DCONF_FILE}"
  _thyx_remove_one "${THYX_STATE_DIR}"

  if [ "${THYX_KEEP_FONTS}" -eq 0 ]; then
    _thyx_remove_one "${THYX_FONTS_DST}"
    if command -v fc-cache >/dev/null 2>&1; then
      _thyx_run fc-cache -f >/dev/null || true
    fi
  fi

  if command -v dconf >/dev/null 2>&1; then
    _thyx_run dconf update || _thyx_warn "dconf update failed"
  fi

  _thyx_ok "thyx files removed"

  _thyx_step "verify"
  _thyx_uninstall_verify

  _thyx_hr
  _thyx_ok "thyx is gone"
  _thyx_log "  Log out or reboot to see the distro greeter again."
  _thyx_hr
}

main "$@"
