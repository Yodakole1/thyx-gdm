#!/usr/bin/env bash
#
# Installs the built theme as GDM's greeter theme.
#
# The stock bundle is never edited. Thyx installs its own copy alongside it and
# points the gdm-theme alternative at it, so `scripts/uninstall` -- or one
# update-alternatives call from a TTY -- puts everything back.

set -Eeuo pipefail

THYX_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=scripts/lib/_constants.sh
. "${THYX_SCRIPT_DIR}/lib/_constants.sh"
# shellcheck source=scripts/lib/_common.sh
. "${THYX_SCRIPT_DIR}/lib/_common.sh"
# shellcheck source=scripts/lib/_repo.sh
. "${THYX_SCRIPT_DIR}/lib/_repo.sh"
# shellcheck source=scripts/lib/_conf.sh
. "${THYX_SCRIPT_DIR}/lib/_conf.sh"
# shellcheck source=scripts/lib/_gdm.sh
. "${THYX_SCRIPT_DIR}/lib/_gdm.sh"

trap '_thyx_on_err' ERR

THYX_INSTALL_BUILD=1
THYX_INSTALL_CONFIG=""
THYX_INSTALL_CHECK=0

_thyx_install_usage() {
  cat <<'EOF'
usage: scripts/install [--config FILE] [--no-build] [--yes]
       scripts/install --check

  --config FILE   install this config instead of theme.conf
  --no-build      install what is already in build/
  --yes, -y       do not ask for confirmation
  --check         report whether the installed theme is still current,
                  and change nothing. Exits 0 when it is, 1 when it is
                  not, so it can be run from a timer or an apt hook.
EOF
}

_thyx_install_parse_args() {
  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --config) shift; [ "${#}" -gt 0 ] || _thyx_die "--config needs a file"; THYX_INSTALL_CONFIG="$1" ;;
      --no-build) THYX_INSTALL_BUILD=0 ;;
      --check) THYX_INSTALL_CHECK=1 ;;
      --yes|-y) THYX_AUTO_YES=1 ;;
      --help|-h) _thyx_install_usage; exit 0 ;;
      *) _thyx_die "unknown arg: $1" ;;
    esac
    shift
  done
}

_thyx_install_require() {
  local missing=()
  local cmd

  for cmd in gresource glib-compile-resources install rm mkdir; do
    command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
  done

  [ "${#missing[@]}" -eq 0 ] || _thyx_die "missing commands: ${missing[*]}"

  command -v gnome-shell >/dev/null 2>&1 ||
    _thyx_die "gnome-shell is not installed; this is a GDM theme"

  command -v dconf >/dev/null 2>&1 ||
    _thyx_warn "dconf is missing: greeter settings (font, clock, logo) will be skipped"

  command -v fc-cache >/dev/null 2>&1 ||
    _thyx_warn "fc-cache is missing: bundled fonts will not be registered"

  if ! systemctl list-unit-files gdm.service >/dev/null 2>&1 &&
     ! systemctl list-unit-files gdm3.service >/dev/null 2>&1; then
    _thyx_warn "no gdm unit found; installing anyway"
  fi
}

_thyx_install_plan() {
  local gresource="${1:?}"
  local method="${2:?}"

  _thyx_hr
  _thyx_log "  theme      ${THYX_GRESOURCE_DST}"
  _thyx_log "  built from $(awk -F= '/^source=/ { print $2 }' "${THYX_BUILD_DIR}/build.info")"
  _thyx_log "  size       $(du -h "${gresource}" | cut -f1)"
  _thyx_log "  activation ${method}"
  if [ "${method}" = "alternatives" ]; then
    _thyx_log "             update-alternatives --install ${THYX_GDM_LINK} ${THYX_ALTERNATIVE} <theme> ${THYX_ALTERNATIVE_PRIORITY}"
  else
    _thyx_log "             $(_thyx_target_file) replaced, backup at ${THYX_GDM_BACKUP}"
  fi
  _thyx_log "  fonts      ${THYX_FONTS_DST}"
  _thyx_log "  wordmark   ${THYX_LOGO_DST}"
  if [ -s "${THYX_BUILD_DIR}/${THYX_EXTENSION_CONFIG_NAME}" ]; then
    _thyx_log "  clock      ${THYX_EXTENSION_DST}"
  fi
  _thyx_log "  settings   ${THYX_DCONF_FILE}"
  _thyx_log "             ${THYX_DCONF_PROFILE_FILE} (only if the packaged profile reads no system db)"
  _thyx_log "  state      ${THYX_STATE_FILE}"
  _thyx_hr
  _thyx_log ""
  _thyx_log "  Your current session is not touched. The new greeter appears"
  _thyx_log "  the next time you log out or reboot."
  _thyx_log ""
}

_thyx_install_fonts() {
  local fonts="${THYX_REPO_DIR}/fonts"
  local found

  found="$(find "${fonts}" -maxdepth 1 -type f \( -name '*.ttf' -o -name '*.otf' \) 2>/dev/null | wc -l)"

  if [ "${found}" -eq 0 ]; then
    _thyx_warn "no bundled fonts in ${fonts}; skipping"
    return 0
  fi

  _thyx_run mkdir -p -- "${THYX_FONTS_DST}"
  _thyx_run find "${fonts}" -maxdepth 1 -type f \( -name '*.ttf' -o -name '*.otf' \) \
    -exec install -m 0644 -t "${THYX_FONTS_DST}" {} +

  if command -v fc-cache >/dev/null 2>&1; then
    _thyx_run fc-cache -f "${THYX_FONTS_DST}" >/dev/null
  fi

  _thyx_ok "installed ${found} font file(s) to ${THYX_FONTS_DST}"
}

THYX_PROFILE_OUTCOME="none"

_thyx_install_settings() {
  local settings="${THYX_BUILD_DIR}/greeter.dconf"

  if ! command -v dconf >/dev/null 2>&1; then
    return 0
  fi

  [ -f "${settings}" ] || { _thyx_warn "no greeter.dconf in build/; skipping settings"; return 0; }

  _thyx_run mkdir -p -- "${THYX_DCONF_DIR}"
  _thyx_run install -m 0644 -- "${settings}" "${THYX_DCONF_FILE}"

  # A keyfile in gdm.d is inert unless the greeter's profile names a system
  # database, and Ubuntu's does not. Nothing packaged is edited to fix that;
  # see _thyx_dconf_profile_ensure.
  THYX_PROFILE_OUTCOME="$(_thyx_dconf_profile_ensure)"
  case "${THYX_PROFILE_OUTCOME}" in
    created) _thyx_ok "wrote ${THYX_DCONF_PROFILE_FILE} (the packaged profile reads no system database)" ;;
    edited)  _thyx_ok "added system-db:${THYX_DCONF_SYSTEM_DB} to ${THYX_DCONF_PROFILE_FILE}" ;;
    *)       _thyx_ok "greeter profile already reads ${THYX_DCONF_DIR}" ;;
  esac

  # GDM reads a compiled database, not the keyfile.
  _thyx_run dconf update || _thyx_warn "dconf update failed; greeter settings may not apply"

  _thyx_ok "greeter settings at ${THYX_DCONF_FILE}"
}

# The wordmark cannot live in the gresource: GDM's logo key takes a path.
_thyx_install_logo() {
  local logo="${THYX_BUILD_DIR}/${THYX_LOGO_NAME}"

  if [ ! -s "${logo}" ]; then
    _thyx_remove_one "${THYX_LOGO_DST}"
    _thyx_ok "no wordmark to install"
    return 0
  fi

  _thyx_run mkdir -p -- "${THYX_THEME_ROOT}"
  _thyx_run install -m 0644 -- "${logo}" "${THYX_LOGO_DST}"
  _thyx_ok "installed ${THYX_LOGO_DST}"
}

# The greeter extension that draws the display clock.
#
# Installed only when the build produced a config for it, and removed when it
# did not, so turning ShowClock off in theme.conf takes the extension off the
# machine rather than leaving a disabled copy behind. Enabling it is a
# separate matter: that is the enabled-extensions key in GDM's dconf profile,
# which _thyx_install_settings writes from the same build.
_thyx_install_extension() {
  local config="${THYX_BUILD_DIR}/${THYX_EXTENSION_CONFIG_NAME}"
  local source="${THYX_REPO_DIR}/${THYX_EXTENSION_SRC}"

  if [ ! -s "${config}" ]; then
    _thyx_remove_one "${THYX_EXTENSION_DST}"
    _thyx_ok "no display clock to install"
    return 0
  fi

  [ -f "${source}/metadata.json" ] ||
    _thyx_die "the extension is missing from the repo: ${source}"

  # Replaced whole rather than merged: a file left over from an older version
  # would be loaded right alongside the new ones.
  _thyx_remove_one "${THYX_EXTENSION_DST}"
  _thyx_run mkdir -p -- "${THYX_EXTENSION_DST}"
  _thyx_run install -m 0644 -t "${THYX_EXTENSION_DST}" -- \
    "${source}/metadata.json" "${source}/extension.js"
  _thyx_run install -m 0644 -- "${config}" "${THYX_EXTENSION_DST}/config.json"

  _thyx_ok "installed ${THYX_EXTENSION_DST}"
}

_thyx_install_theme() {
  local gresource="${1:?}"

  _thyx_run mkdir -p -- "${THYX_THEME_ROOT}"

  # Staged then renamed: the greeter never reads a partly written bundle.
  _thyx_run install -m 0644 -- "${gresource}" "${THYX_GRESOURCE_DST}.new"
  _thyx_run mv -f -- "${THYX_GRESOURCE_DST}.new" "${THYX_GRESOURCE_DST}"

  _thyx_ok "installed ${THYX_GRESOURCE_DST}"
}

_thyx_install_state() {
  local method="${1:?}"

  _thyx_run mkdir -p -- "${THYX_STATE_DIR}"
  {
    printf 'version=3\n'
    printf 'method=%s\n' "${method}"
    printf 'dconf_profile=%s\n' "${THYX_PROFILE_OUTCOME}"
    printf 'gresource=%s\n' "${THYX_GRESOURCE_DST}"
    printf 'installed=%s\n' "$(date -Iseconds)"
    cat "${THYX_BUILD_DIR}/build.info"
  } | _thyx_run tee "${THYX_STATE_FILE}" >/dev/null
}

_thyx_install_verify() {
  local active

  [ -f "${THYX_GRESOURCE_DST}" ] || _thyx_die "theme missing after install: ${THYX_GRESOURCE_DST}"

  gresource list "${THYX_GRESOURCE_DST}" >/dev/null 2>&1 ||
    _thyx_die "installed theme is not a readable resource bundle"

  active="$(_thyx_active_gresource || true)"
  [ -n "${active}" ] || _thyx_die "no greeter theme is selected"

  if [ "${active}" != "${THYX_GRESOURCE_DST}" ]; then
    _thyx_die "greeter still points at ${active}; thyx did not take effect"
  fi

  _thyx_ok "greeter theme resolves to ${active}"

  # The settings half of the install has its own failure mode, and it is a
  # quiet one: a keyfile that no profile reaches looks installed and does
  # nothing. Read a key back the way the greeter will.
  if command -v dconf >/dev/null 2>&1 && [ -f "${THYX_DCONF_FILE}" ]; then
    local seen expected
    expected="$(awk -F= '/^logo=/ { print $2 }' "${THYX_DCONF_FILE}")"
    seen="$(_thyx_dconf_greeter_read /org/gnome/login-screen/logo || true)"

    if [ "${seen}" = "${expected}" ]; then
      _thyx_ok "greeter settings read back through DCONF_PROFILE=${THYX_DCONF_SYSTEM_DB}"
    else
      _thyx_warn "greeter reads logo=${seen:-<unset>}, expected ${expected}"
      _thyx_warn "the clock, font and wordmark settings may not apply; the theme itself will"
    fi
  fi
}

# --- --check ---------------------------------------------------------------
#
# The install is a snapshot: the bundle Thyx ships is a whole copy of whatever
# upstream greeter theme existed at build time, with our block appended. That
# copy does not move when gnome-shell or the distro theme is upgraded, and
# nothing complains -- update-alternatives keeps pointing at a perfectly valid
# file that is simply out of date. build.info records the source and its hash
# for exactly this reason; this is what reads them back.
#
# Read-only, and deliberately sudo-free. Findings are collected rather than
# fatal, so one run tells you everything that drifted.

THYX_CHECK_FINDINGS=0

_thyx_check_fail() {
  THYX_CHECK_FINDINGS=$(( THYX_CHECK_FINDINGS + 1 ))
  _thyx_warn "$*"
}

_thyx_check_source() {
  local source recorded current

  source="$(_thyx_state_get source || true)"
  recorded="$(_thyx_state_get source_sha256 || true)"

  if [ -z "${source}" ] || [ -z "${recorded}" ]; then
    _thyx_check_fail "the state file records no source; reinstall to refresh it"
    return 0
  fi

  if [ ! -f "${source}" ]; then
    _thyx_check_fail "the upstream theme this was built from is gone: ${source}"
    _thyx_log "  A distro upgrade can move it. Rebuild against whatever is there now."
    _thyx_log ""
    return 0
  fi

  current="$(sha256sum "${source}" | cut -d" " -f1)"

  if [ "${current}" = "${recorded}" ]; then
    _thyx_ok "built from the upstream theme that is installed today"
    return 0
  fi

  _thyx_check_fail "upstream has moved since this was built"
  _thyx_log "  source   ${source}"
  _thyx_log "  built on ${recorded}"
  _thyx_log "  now      ${current}"
  _thyx_log ""
  _thyx_log "  The greeter is loading a copy of the older bundle. Nothing is"
  _thyx_log "  broken by that on its own, but upstream fixes and any resources"
  _thyx_log "  added since are missing from it."
  _thyx_log ""
}

_thyx_check_active() {
  local active

  if [ ! -f "${THYX_GRESOURCE_DST}" ]; then
    _thyx_check_fail "the installed theme is gone: ${THYX_GRESOURCE_DST}"
    return 0
  fi

  if ! gresource list "${THYX_GRESOURCE_DST}" >/dev/null 2>&1; then
    _thyx_check_fail "the installed theme is not a readable resource bundle"
    return 0
  fi

  active="$(_thyx_active_gresource || true)"

  if [ -z "${active}" ]; then
    _thyx_check_fail "no greeter theme is selected at all"
  elif [ "${active}" != "${THYX_GRESOURCE_DST}" ]; then
    _thyx_check_fail "the greeter points at ${active}, not at thyx"
    _thyx_log "  Something reclaimed the selection. Reinstall to take it back."
    _thyx_log ""
  else
    _thyx_ok "the greeter resolves to ${active}"
  fi
}

_thyx_check_settings() {
  local profile

  if [ ! -f "${THYX_DCONF_FILE}" ]; then
    _thyx_check_fail "greeter settings are missing: ${THYX_DCONF_FILE}"
    return 0
  fi

  profile="$(_thyx_dconf_profile_effective || true)"

  if [ -z "${profile}" ]; then
    _thyx_check_fail "no greeter dconf profile at all; the settings cannot be read"
    return 0
  fi

  if ! _thyx_dconf_profile_has_system_db "${profile}"; then
    _thyx_check_fail "${profile} no longer reads system-db:${THYX_DCONF_SYSTEM_DB}"
    _thyx_log "  The keyfile is still there and still inert: the font, clock and"
    _thyx_log "  wordmark settings will not reach the greeter until this is put"
    _thyx_log "  back. Reinstalling writes it again."
    _thyx_log ""
    return 0
  fi

  _thyx_ok "greeter settings are reachable through ${profile}"
}

_thyx_check() {
  _thyx_step "check"

  if [ ! -f "${THYX_STATE_FILE}" ]; then
    _thyx_log "thyx is not installed (no ${THYX_STATE_FILE})."
    exit 1
  fi

  _thyx_log "  installed ${THYX_STATE_FILE}"
  _thyx_log "  on        $(_thyx_state_get installed || printf "unknown")"
  _thyx_log "  from      $(_thyx_state_get config || printf "unknown")"
  _thyx_log ""

  _thyx_check_active
  _thyx_check_source
  _thyx_check_settings

  _thyx_hr
  if [ "${THYX_CHECK_FINDINGS}" -eq 0 ]; then
    _thyx_ok "thyx is installed and current"
    exit 0
  fi

  if [ "${THYX_CHECK_FINDINGS}" -eq 1 ]; then
    _thyx_log "1 thing needs attention. In most cases:"
  else
    _thyx_log "${THYX_CHECK_FINDINGS} things need attention. In most cases:"
  fi
  _thyx_log ""
  _thyx_log "    sudo ./scripts/install"
  _thyx_log ""
  exit 1
}

main() {
  _thyx_install_parse_args "$@"

  if [ "${THYX_INSTALL_CHECK}" -eq 1 ]; then
    command -v gresource >/dev/null 2>&1 ||
      _thyx_die "gresource is missing (install libglib2.0-bin)"
    command -v sha256sum >/dev/null 2>&1 || _thyx_die "sha256sum is missing"
    _thyx_check
  fi

  _thyx_install_require

  THYX_REPO_DIR="$(_thyx_find_repo "${THYX_SCRIPT_DIR}")"
  THYX_BUILD_DIR="${THYX_REPO_DIR}/build"
  THYX_LOG_PREFIX="thyx-install"
  _thyx_setup_log

  if [ "${THYX_INSTALL_BUILD}" -eq 1 ]; then
    _thyx_step "build"
    if [ -n "${THYX_INSTALL_CONFIG}" ]; then
      "${THYX_SCRIPT_DIR}/build" --config "${THYX_INSTALL_CONFIG}"
    else
      "${THYX_SCRIPT_DIR}/build"
    fi
  fi

  local gresource="${THYX_BUILD_DIR}/${THYX_GRESOURCE_NAME}"
  [ -f "${gresource}" ] || _thyx_die "nothing built: run scripts/build first"
  [ -f "${THYX_BUILD_DIR}/build.info" ] || _thyx_die "build/build.info missing: rebuild"

  local method
  method="$(_thyx_activation_method)"

  _thyx_step "plan"
  _thyx_install_plan "${gresource}" "${method}"
  _thyx_confirm "install thyx as the GDM greeter theme? [y/N]"

  _thyx_sudo_warmup

  _thyx_step "fonts"
  _thyx_install_fonts

  _thyx_step "theme"
  _thyx_install_theme "${gresource}"

  _thyx_step "activate"
  _thyx_activate "${THYX_GRESOURCE_DST}"

  _thyx_step "wordmark"
  _thyx_install_logo

  _thyx_step "display clock"
  _thyx_install_extension

  _thyx_step "settings"
  _thyx_install_settings

  _thyx_install_state "${method}"

  _thyx_step "verify"
  _thyx_install_verify

  _thyx_hr
  _thyx_ok "thyx is installed"
  _thyx_log "  Preview without logging out:  ./scripts/preview"
  _thyx_log "  See it for real:              log out, or reboot"
  _thyx_log "  Undo everything:              ./scripts/uninstall"
  _thyx_log ""
  _thyx_log "  If the greeter ever misbehaves, switch to a TTY with Ctrl+Alt+F3"
  _thyx_log "  and run ./scripts/uninstall from this directory."
  _thyx_hr
}

main "$@"
