/* ==========================================================================
   Thyx for GDM
   --------------------------------------------------------------------------
   This block is appended to the stock gdm.css of the running GNOME Shell,
   so every rule here is an override and nothing from upstream is lost.

   Generated by scripts/build from theme.conf. Do not edit the built copy;
   edit theme.conf (or a file in presets/) and rebuild.

   Ubuntu's Yaru sheet ends with `* { font-weight: normal !important; }`,
   which is why weights below are marked important: a class selector with
   !important outranks a universal selector with !important.
   ========================================================================== */

/* --- Canvas ------------------------------------------------------------- */

stage {
  font-family: "@Font@";
  font-size: @FontSize@pt;
  color: @LoginFieldTextColor@;
}

/* The greeter's backdrop. The image is baked into this theme's gresource by
   scripts/build, already scaled, blurred and dimmed, so the shell only has to
   blit it. */
#lockDialogGroup {
  background-color: @BackgroundColor@;
@BackgroundImage@
}

.screen-shield-background {
  background: transparent;
  box-shadow: none;
}

/* --- Top bar ------------------------------------------------------------
   GDM has no standalone clock widget; the date menu in the top bar is the
   only clock on screen, so Thyx grows it into the page's timestamp. */

#panel {
  background-color: transparent !important;
  height: @PanelHeight@px;
  font-weight: @WeightUI@ !important;
}

#panel:overview,
#panel.solid {
  background-color: transparent !important;
}

#panel .panel-button {
  color: @SystemButtonsIconsColor@;
  border-radius: @RadiusSmall@px;
  transition-duration: @AnimationDuration@ms;
}

#panel .panel-button:hover,
#panel .panel-button:active,
#panel .panel-button:overview,
#panel .panel-button:focus {
  color: @HoverSystemButtonsIconsColor@;
  background-color: @ChromeHoverBg@;
  box-shadow: none;
}

#panel .panel-button .system-status-icon {
  icon-size: @StatusIconSize@px;
}

#panel #panelLeft,
#panel #panelRight {
  /* Keep the side clusters compact so the enlarged clock stays centred. */
  spacing: 4px;
}

#panel .clock-display,
#panel .clock-display .clock {
  color: @TimeTextColor@;
  font-size: @ClockSize@pt;
  font-weight: @ClockWeight@ !important;
  letter-spacing: -0.5px;
}

#panel .clock-display StLabel {
  color: @TimeTextColor@;
}

#panel .clock-display:hover .clock,
#panel .clock-display:focus .clock,
#panel .clock-display:active .clock {
  color: @DateTextColor@;
}

/* --- Login dialog shell -------------------------------------------------- */

.login-dialog {
  background-color: transparent;
}

/* Where the sign-in column sits.
   GDM centres the form on the primary monitor and exposes no anchor for it,
   and St has no percentage lengths to lay one out with. What it does honour
   is padding, and a centred box grows both ways from its middle: padding one
   flank by 2n slides everything visible n pixels the other way, whatever the
   monitor is doing. FormPosition="center" leaves both at 0. */
.login-dialog-user-selection-box {
  padding-top: @FormPadding@px;
  padding-bottom: @FormPadding@px;
  padding-left: @UserBoxPadLeft@px;
  padding-right: @UserBoxPadRight@px;
  border-radius: @Radius@px;
  background-color: @FormBg@;
}

.login-dialog-prompt-layout {
  padding-left: @FormPadLeft@px;
  padding-right: @FormPadRight@px;
  spacing: @ListSpacing@px;
}

/* The wordmark at the foot of the screen.
   GDM allocates this bin at `screen_bottom - bin_height` and does not clip
   what is inside it, so a bin shorter than its image leaves the difference
   hanging off the bottom edge -- which is exactly what a fixed height here
   used to do to Ubuntu's 87px mark. Hence no height at all: the bin takes
   the image's size, and the margin is what holds it clear of the edge.
   With ShowLogo off the logo key is empty, the bin has no child, and this
   collapses to nothing. */
.login-dialog-logo-bin {
  /* Padded on the same flank as the form, by the same amount, so the mark
     travels with the column instead of stranding itself under the middle of
     an empty screen. GDM centres this bin too, so the trick is the same one. */
  padding: 0 @FormPadRight@px 0 @FormPadLeft@px;
  margin: 0 0 @LogoMarginBottom@px 0;
}

.login-dialog-banner {
  color: @PlaceholderTextColor@;
}

/* --- The person you are signing in as ------------------------------------ */

.login-dialog .user-widget .user-widget-label {
  color: @LoginFieldTextColor@;
  font-weight: @WeightEmphasis@ !important;
}

.login-dialog .user-widget.vertical .user-widget-label {
  font-size: @UserNameSize@pt;
  margin-bottom: 0.6em;
}

.login-dialog .user-widget .user-icon {
  background-gradient-direction: vertical;
  background-gradient-start: @FieldGradientTop@;
  background-gradient-end: @AvatarBg@;
  color: @LoginFieldTextColor@;
  border: @AvatarBorderWidth@px solid @AvatarBorderColor@;
  border-radius: @AvatarRadius@px;
}

.login-dialog .user-widget.vertical .user-icon {
  icon-size: @AvatarSize@px;
}

/* --- User list ----------------------------------------------------------- */

.login-dialog-user-list {
  spacing: @ListSpacing@px;
}

.login-dialog-user-list-item {
  color: @LoginFieldTextColor@;
  border-radius: @Radius@px;
  padding: @ListItemPadding@px;
  background-color: @FieldBg@;
  transition-duration: @AnimationDuration@ms;
}

.login-dialog-user-list-item:hover {
  background-color: @FieldBgHover@;
  color: @LoginFieldTextColor@;
}

.login-dialog-user-list-item:focus,
.login-dialog-user-list-item:selected {
  background-color: @FieldBgHover@;
  color: @LoginFieldTextColor@;
  box-shadow: inset 0 0 0 @FocusRingWidth@px @FocusRingColor@ !important;
}

.login-dialog-user-list-item .login-dialog-timed-login-indicator {
  background-color: @LoginButtonBackgroundColor@;
  height: 2px;
}

.login-dialog-not-listed-button {
  border-radius: @Radius@px;
  padding: 8px 20px;
  background-color: transparent;
  transition-duration: @AnimationDuration@ms;
}

.login-dialog-not-listed-button .login-dialog-not-listed-label {
  color: @EnvironmentButtonTextColor@;
  font-weight: @WeightUI@ !important;
}

.login-dialog-not-listed-button:hover,
.login-dialog-not-listed-button:focus {
  background-color: @ChromeHoverBg@;
  box-shadow: none !important;
}

.login-dialog-not-listed-button:hover .login-dialog-not-listed-label,
.login-dialog-not-listed-button:focus .login-dialog-not-listed-label {
  color: @HoverEnvironmentButtonTextColor@;
}

/* --- Password / PIN entry ------------------------------------------------
   Thyx's signature: a wide, soft, translucent pill. */

.login-dialog .login-dialog-prompt-entry,
.login-dialog-prompt-entry {
  width: @FieldWidth@em;
  min-height: @FieldHeight@px;
  padding: 0 @FieldPaddingX@px;
  border-radius: @FieldRadius@px;
  /* A hairline in the accent, so the pill is legible against a bright
     wallpaper instead of relying on the fill alone. */
  border: 1px solid @AccentSoft@;
  /* St's own gradient properties -- not CSS3 -- give the pill a little
     depth without a second actor behind it. */
  background-gradient-direction: vertical;
  background-gradient-start: @FieldGradientTop@;
  background-gradient-end: @FieldGradientBottom@;
  color: @LoginFieldTextColor@;
  caret-color: @LoginButtonBackgroundColor@;
  selection-background-color: @LoginButtonBackgroundColor@;
  selected-color: @LoginButtonTextColor@;
  font-weight: @FieldWeight@ !important;
  text-align: center;
  transition-duration: @AnimationDuration@ms;
  box-shadow: none;
}

.login-dialog .login-dialog-prompt-entry:hover,
.login-dialog-prompt-entry:hover {
  border: 1px solid @AccentEdge@;
  background-gradient-start: @FieldBgHover@;
  background-gradient-end: @FieldBgFocus@;
  color: @LoginFieldTextColor@;
}

.login-dialog .login-dialog-prompt-entry:focus,
.login-dialog-prompt-entry:focus {
  border: 1px solid @FocusRingColor@;
  background-gradient-start: @FieldBgFocus@;
  background-gradient-end: @FieldBgFocus@;
  color: @LoginFieldTextColor@;
  box-shadow: inset 0 0 0 @FocusRingWidth@px @FocusRingColor@ !important;
}

.login-dialog .login-dialog-prompt-entry:insensitive,
.login-dialog-prompt-entry:insensitive {
  border: 1px solid @AccentSoft@;
  background-gradient-start: @FieldBg@;
  background-gradient-end: @FieldBg@;
  color: @PlaceholderTextColor@;
}

.login-dialog .login-dialog-prompt-entry StLabel.hint-text,
.login-dialog-prompt-entry StLabel.hint-text {
  color: @PlaceholderTextColor@;
  font-weight: @WeightUI@ !important;
}

/* --- Messages: hints, caps lock, wrong password -------------------------- */

.login-dialog-message {
  color: @PlaceholderTextColor@;
  font-weight: @WeightUI@ !important;
  padding-top: 6px;
}

.login-dialog-message-hint {
  color: @PlaceholderTextColor@;
}

.login-dialog-message-warning {
  color: @WarningTextColor@;
  font-weight: @WeightEmphasis@ !important;
}

/* Caps Lock is announced through the generic warning label. */
.caps-lock-warning-label {
  color: @WarningTextColor@;
  font-weight: @WeightEmphasis@ !important;
}

/* --- Buttons ------------------------------------------------------------- */

/* Cancel, Unlock/Next, session picker, auth-method picker. */
.login-dialog-button.cancel-button,
.login-dialog-button.switch-user-button,
.login-dialog-button.login-dialog-auth-menu-button,
.login-dialog-button.login-dialog-session-list-button {
  color: @EnvironmentButtonTextColor@;
  background-color: @ChromeBg@;
  border-radius: @Radius@px;
  border: none;
  box-shadow: none;
  transition-duration: @AnimationDuration@ms;
}

.login-dialog-button.cancel-button:hover,
.login-dialog-button.switch-user-button:hover,
.login-dialog-button.login-dialog-auth-menu-button:hover,
.login-dialog-button.login-dialog-session-list-button:hover {
  color: @HoverEnvironmentButtonTextColor@;
  background-color: @ChromeHoverBg@;
}

.login-dialog-button.cancel-button:focus,
.login-dialog-button.switch-user-button:focus,
.login-dialog-button.login-dialog-auth-menu-button:focus,
.login-dialog-button.login-dialog-session-list-button:focus {
  color: @HoverEnvironmentButtonTextColor@;
  background-color: @ChromeHoverBg@;
  box-shadow: inset 0 0 0 @FocusRingWidth@px @FocusRingColor@ !important;
}

.login-dialog-button.cancel-button:active,
.login-dialog-button.switch-user-button:active,
.login-dialog-button.login-dialog-auth-menu-button:active,
.login-dialog-button.login-dialog-session-list-button:active {
  color: @LoginFieldTextColor@;
  background-color: @ChromeActiveBg@;
}

/* The primary action (Sign In / Unlock) carries the accent. */
.default.login-dialog-button.cancel-button,
.default.login-dialog-button.switch-user-button,
.default.login-dialog-button.login-dialog-auth-menu-button,
.default.login-dialog-button.login-dialog-session-list-button,
.login-dialog-button.default {
  color: @LoginButtonTextColor@;
  background-color: @LoginButtonBackgroundColor@;
  border-radius: @Radius@px;
  font-weight: @ButtonWeight@ !important;
}

.default.login-dialog-button.cancel-button:hover,
.default.login-dialog-button.switch-user-button:hover,
.default.login-dialog-button.login-dialog-auth-menu-button:hover,
.default.login-dialog-button.login-dialog-session-list-button:hover,
.login-dialog-button.default:hover {
  color: @LoginButtonTextColor@;
  background-color: @HoverLoginButtonBackgroundColor@;
}

.default.login-dialog-button.cancel-button:focus,
.default.login-dialog-button.switch-user-button:focus,
.default.login-dialog-button.login-dialog-auth-menu-button:focus,
.default.login-dialog-button.login-dialog-session-list-button:focus,
.login-dialog-button.default:focus {
  color: @LoginButtonTextColor@;
  background-color: @HoverLoginButtonBackgroundColor@;
  box-shadow: inset 0 0 0 @FocusRingWidth@px @FocusRingColor@ !important;
}

.default.login-dialog-button.cancel-button:active,
.default.login-dialog-button.switch-user-button:active,
.default.login-dialog-button.login-dialog-auth-menu-button:active,
.default.login-dialog-button.login-dialog-session-list-button:active,
.login-dialog-button.default:active {
  color: @LoginButtonTextColor@;
  background-color: @PressedLoginButtonBackgroundColor@;
}

.login-dialog-button-box {
  spacing: @ListSpacing@px;
}

/* --- Session and login-options pickers -----------------------------------
   These two live in the bottom-right corner and are the only way to pick
   Wayland vs Xorg, or a different authentication method, before signing in.
   GDM gives them no label at all -- each is a bare gear glyph on a flat
   background, which is easy to read as decoration. Thyx draws them as
   outlined pills that pick up the accent on hover, and gives the menu they
   open a heading, so the choice announces itself. */

.login-dialog-menu-button-box {
  spacing: @ListSpacing@px;
  padding: 0 @FormPadding@px @FormPadding@px @FormPadding@px;
}

.login-dialog-menu-button-box .login-dialog-button.login-dialog-auth-menu-button,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-session-list-button {
  width: @MenuButtonSize@px;
  height: @MenuButtonSize@px;
  padding: 0;
  border-radius: @MenuButtonRadius@px;
  border: @MenuButtonBorderWidth@px solid @AccentEdge@;
  background-color: @AccentSoft@;
  color: @SystemButtonsIconsColor@;
  transition-duration: @AnimationDuration@ms;
}

.login-dialog-menu-button-box .login-dialog-button.login-dialog-auth-menu-button StIcon,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-session-list-button StIcon {
  icon-size: @MenuButtonIconSize@px;
}

.login-dialog-menu-button-box .login-dialog-button.login-dialog-auth-menu-button:hover,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-session-list-button:hover {
  border: @MenuButtonBorderWidth@px solid @LoginButtonBackgroundColor@;
  background-color: @AccentGlow@;
  color: @HoverSystemButtonsIconsColor@;
}

.login-dialog-menu-button-box .login-dialog-button.login-dialog-auth-menu-button:focus,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-session-list-button:focus {
  border: @MenuButtonBorderWidth@px solid @FocusRingColor@;
  background-color: @AccentGlow@;
  color: @HoverSystemButtonsIconsColor@;
  box-shadow: inset 0 0 0 @FocusRingWidth@px @FocusRingColor@ !important;
}

.login-dialog-menu-button-box .login-dialog-button.login-dialog-auth-menu-button:checked,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-session-list-button:checked,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-auth-menu-button:active,
.login-dialog-menu-button-box .login-dialog-button.login-dialog-session-list-button:active {
  border: @MenuButtonBorderWidth@px solid @LoginButtonBackgroundColor@;
  background-color: @LoginButtonBackgroundColor@;
  color: @LoginButtonTextColor@;
}

/* The heading inside the menu -- "Session" -- which stock GDM greys out. */
.login-dialog-auth-menu-button-title {
  color: @LoginButtonBackgroundColor@;
  font-weight: @WeightEmphasis@ !important;
  letter-spacing: 0.5px;
}

/* --- Session / auth-method menus ----------------------------------------- */

.login-dialog-auth-menu-button-popup-menu-box,
.popup-menu-boxpointer,
.popup-menu-content {
  background-color: @DropdownBackgroundColor@;
  border: 1px solid @DropdownBorderColor@;
  border-radius: @Radius@px;
}

.popup-menu .popup-menu-item {
  color: @DropdownTextColor@;
  border-radius: @RadiusSmall@px;
  transition-duration: @AnimationDuration@ms;
}

.popup-menu .popup-menu-item:hover,
.popup-menu .popup-menu-item:focus,
.popup-menu .popup-menu-item.selected,
.popup-menu .popup-menu-item:active {
  color: @DropdownSelectedTextColor@;
  background-color: @DropdownSelectedBackgroundColor@;
}

.popup-menu .popup-menu-item:checked {
  color: @DropdownSelectedTextColor@;
  background-color: @DropdownSelectedBackgroundColor@;
}

.popup-separator-menu-item .popup-separator-menu-item-separator {
  background-color: @DropdownBorderColor@;
}

/* --- Quick settings (power / restart / suspend live here) ---------------- */

.quick-settings {
  background-color: @DropdownBackgroundColor@;
  border: 1px solid @DropdownBorderColor@;
  border-radius: @Radius@px;
}

.quick-settings .icon-button,
.quick-toggle {
  color: @SystemButtonsIconsColor@;
  background-color: @ChromeBg@;
  border-radius: @RadiusSmall@px;
}

.quick-settings .icon-button:hover,
.quick-toggle:hover {
  color: @HoverSystemButtonsIconsColor@;
  background-color: @ChromeHoverBg@;
}

.quick-toggle:checked,
.quick-settings .icon-button:checked {
  color: @LoginButtonTextColor@;
  background-color: @LoginButtonBackgroundColor@;
}

/* --- Modal dialogs (restart/shutdown confirmations, session conflicts) ---- */

.modal-dialog {
  background-color: @DropdownBackgroundColor@;
  border: 1px solid @DropdownBorderColor@;
  border-radius: @Radius@px;
  color: @LoginFieldTextColor@;
}

.modal-dialog .modal-dialog-linked-button {
  color: @EnvironmentButtonTextColor@;
  background-color: @ChromeBg@;
}

.modal-dialog .modal-dialog-linked-button:hover,
.modal-dialog .modal-dialog-linked-button:focus {
  color: @HoverEnvironmentButtonTextColor@;
  background-color: @ChromeHoverBg@;
}

.modal-dialog .modal-dialog-linked-button:default {
  color: @LoginButtonTextColor@;
  background-color: @LoginButtonBackgroundColor@;
}

/* --- Everything else that should follow the accent ----------------------- */

.candidate-box:selected,
.candidate-box:hover {
  background-color: @DropdownSelectedBackgroundColor@;
  color: @DropdownSelectedTextColor@;
}

.osd-window {
  background-color: @DropdownBackgroundColor@;
  border: 1px solid @DropdownBorderColor@;
  border-radius: @Radius@px;
  color: @LoginFieldTextColor@;
}

.osd-window .level .level-fill {
  background-color: @LoginButtonBackgroundColor@;
}

.spinner,
.web-login-spinner {
  color: @LoginButtonBackgroundColor@;
}
